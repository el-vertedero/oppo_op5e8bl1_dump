<?xml version="1.0" encoding="utf-8"?>
<resources>
  <filter-conf>
    <version>2026060801</version>
    <filter-name>sys_preload_config</filter-name>
  </filter-conf>

  <config name="common">
    <!-- main switch config cn-->
    <!-- <switchConfig is used for RUS update, xml in mystock modify this cannot effect"/> -->
		<switchConfig enabled="true" commonPolicy="true" wakePolicy="true" topAppPolicy="true"
		renewPolicy="true" restartProcPolicy="true" miniProgramPolicy="true" breenoPolicy="true" />
		<!-- memory threthrold config -->
		<!-- app used memory(pss) + availableMem should < current sys available-->
		<!-- && current sys free memory should > freeMem, then trigger preload!-->
		<memoryConfig total="4" freeMem="200" availableMem="2000" maxAppSlots="8"/>
		<memoryConfig total="6" freeMem="200" availableMem="2000" maxAppSlots="8"/>
		<memoryConfig total="8" freeMem="350" availableMem="2500" maxAppSlots="12"/>
		<memoryConfig total="12" freeMem="400" availableMem="3000" maxAppSlots="18"/>
		<memoryConfig total="16" freeMem="450" availableMem="4000" maxAppSlots="24"/>
		<memoryConfig total="24" freeMem="450" availableMem="4000" maxAppSlots="30"/>
		<!-- temperature should less than -->
		<temperatureConfig temperature="39"/>
		<!-- cpu Load should less than -->
		<!-- interrupt cpu Load will end preload -->
		<cpuLoadConfig cpuLoad="85" interrupt="95"/>
		<!-- unfreeze counts limit when preloaded -->
		<unfreezeConfig counts="5000"/>
		<!-- kill Reason config -->
		<killReasonConfig reason="13" subReason="2039, 2392, 6001, 6002, 6003, 6004, 6005, 6006, 6008, 6010, 6011, 6012, 6013"/>
		<!-- wake preload config -->
		<wakePreloadConfig slots="20"/>
		<wakeKillReasonConfig reason="10" subReason="25"/>
		<wakeKillReasonConfig reason="13" subReason="2003, 2032, 2033"/>
		<wakeKillReasonConfig reason="16" subReason="0, 21"/>
		<!-- topapp preload config visibleTimeThd=3h-->
		<topAppConfig name="com.ss.android.ugc.aweme" visibleTimeThd="10800000"/>
		<topApp pkg="com.ss.android.ugc.aweme" prio="3"/>
		<topApp pkg="com.smile.gifmaker" prio="2"/>
		<topApp pkg="com.xingin.xhs" prio="1"/>
		<topAppKillReasonConfig reason="13" subReason="2002, 2039, 2040, 2392, 6001, 6002, 6003, 6004, 6005, 6006, 6008, 6010, 6011, 6012, 6013"/>
		<topAppKillReasonConfig reason="10" subReason="22"/>
		<!-- renew preload config dur=0.5h-->
		<renewConfig lruLimit="5" dur="1800000"/>
		<renewKillReasonConfig reason="13" subReason="2002, 2039, 2040, 2392, 2393, 6001, 6002, 6003, 6004, 6005, 6006, 6008, 6010, 6011, 6012, 6013"/>
		<renewKillReasonConfig reason="10" subReason="22"/>
		<!-- proc restart config-->
		<!--osLevel:export,cn osZone:light,full-->
		<restartProcConfig osLevel="01" osZone="01" shortTimeCount="5" dailyCount="20" delay="600" availMem="1500"/>
		<restartProc name="com.tencent.mm"/>
		<restartProc name="com.tencent.mm:push"/>
		<restartProcKillReasonConfig reason="15" subReason="0"/>
		<restartProcKillReasonConfig reason="16" subReason="0"/>
		
		<!-- mini program -->
		<miniProgram pkg="com.tencent.mm" mainProcess ="com.tencent.mm" force="false" 
			    procToPreload="com.tencent.mm:appbrand0|com.tencent.mm:appbrand1" />

		<!-- constant -->
		<douyin name="com.ss.android.ugc.aweme"/>
  </config>

  <config name="activity">
		<!-- policy switch controlled by feature, only can be modified by rus!-->
		<!-- <switchConfig is used for RUS update, xml in mystock modify this cannot effect"/> -->
		<switchConfig enabled="true" onlyHighPerf="false"/>

		<!-- durtime config -->
		<durConfig preloadDur="5000" preloadGameDur="20000"/>

		<!--black list pkg={pkgName}, default is null-->
		<blackList pkg="com.coloros.childrenspace"/>
		<blackList pkg="com.duowan.kiwi"/>
		<blackList pkg="tv.danmaku.bili"/>
		<blackList pkg="us.zoom.videomeetings"/>
		<blackList pkg="com.aligame.sgzzlb.nearme.gamecenter"/>
		<blackList pkg="com.kugou.android.lite"/>
		<blackList pkg="com.kugou.android"/>
		<blackList pkg="com.smile.gifmaker"/>
		<blackList pkg="com.kuaishou.nebula"/>
		<blackList pkg="com.zjgdmj.net.nearme.gamecenter"/>
		<blackList pkg="com.potin.systestlow"/>
		<blackList pkg="com.tencent.mm"/>
		<blackList pkg="com.tencent.mobileqq"/>
		<blackList pkg="com.yibasan.lizhifm"/>

		<!--white list pkg={pkgName}, defalut is null-->
		<whiteList pkg=""/>

		<mem total="8" MaxAppSlots="19"  PreloadGameSlots="1" NeedFreeSlots="5"/>
		<mem total="12" MaxAppSlots="27" PreloadGameSlots="1" NeedFreeSlots="5"/>
		<mem total="16" MaxAppSlots="35" PreloadGameSlots="2" NeedFreeSlots="5"/>
		<!--mem total="24" MaxAppSlots-->
		<!--mem total="32" MaxAppSlots-->
  </config>
	
  <config name="process">
		<!-- policy switch -->
		<switchConfig nextAppPreloadSwitch="true" vipAppPreloadSwitch="true" parallelAppPreloadSwitch="true" sauAppPreload="true" dcsSwitch="true" vipSdkAppPreloadSwitch="true" breenoPreloadSwitch="true" 
		quickBootAppPreloadSwitch = "true" touchAppPreloadSwitch = "true" ioProfileGuidedPreload="true" ioAbilityOpen="true" ioBoostPreload="false"/>
		
		<!-- light preload config-->
		<lightPreloadConfig switch="true" threshold="50"/>

		<!-- share slot config -->
		<shareSlotMem6 sharedSlot="2"/>
		<shareSlotMem8 sharedSlot="3"/>
		<shareSlotMem12 sharedSlot="5"/>

		<!-- isolate slot config, for special preload scene -->
		<isolateSlotMem6 ioSlot="3" processSlot="3"/>
		<isolateSlotMem8 ioSlot="3" processSlot="3"/>
		<isolateSlotMem12 ioSlot="3" processSlot="3"/>
		
		<!-- memory threshold -->
		<memThreshold mem6="2048" mem8="3072" mem12="3072"/>
		
		<!-- vipsdk config -->
		<vipSdkConfig appDiedCount="3" appDiedCountInDay="20" appDiedCountWithinTime="60000" crashStatSwitch="false" delayTime="1"/>
		<vipSdkLevelMem6 ioSlot="0" processSlot="2"/>
		<vipSdkLevelMem8 ioSlot="0" processSlot="2"/>
		<vipSdkLevelMem12 ioSlot="0" processSlot="2"/>

		<!--black list pkg={pkgName} mask={sauAppPreload, parallelAppPreload, vipAppPreload, nextAppPreload}-->
		<!-- next preload-->
		<blackList pkg="com.tencent.qqmusic" mask="0001"/>
		<blackList pkg="com.hogezq.azsjgj" mask="0001"/>
		<blackList pkg="com.tencent.android.qqdownloader" mask="0001"/>
		<blackList pkg="com.tencent.mm" mask="0001"/>
		<blackList pkg="com.kugou.android" mask="0001"/>
		<blackList pkg="com.tencent.qqpim" mask="0001"/>
		<blackList pkg="com.alibaba.wireless" mask="0001"/>
		<!-- vip preload-->
		<blackList pkg="com.tencent.mm" mask="0010"/>

		<!-- dynamic list pkg={pkgName} mask={touchAppPreload sauAppPreload, parallelAppPreload, vipAppPreload, nextAppPreload}-->
		<!-- touch-->
		<dynamicList pkg="com.coloros.gallery3d" mask="10000"/>
		<dynamicList pkg="com.heytap.market" mask="10000"/>
		<!-- imp vipconfig-->

		<!-- common Restriction-->
		<commonRestriction pkg = "com.android.systemui"/>
		<commonRestriction pkg = "com.coloros.assistantscreen"/>	
		<commonRestriction pkg = "com.oplus.secondaryhome"/>
		<commonRestriction pkg = "com.android.launcher"/>
		<commonRestriction pkg = "com.oplus.pantanal.ums"/>
		<!-- callerpkg={pkgName} calleepkg={pkgName} cpnname={cpnname} action={aciton} mask={alarm，job, sync, provider, broadcast, service  }-->
		<restriction action="android.intent.action.MEDIA_BUTTON" mask="000010"/>
		<restriction action="oppo.intent.action.opluscarlink.INIT_OPLUS_SDK" mask="000010"/>

		<!-- iopgp -->
		<iopgpThreshold mem6="50" mem8="50" mem12="50"/>
		<ioOpenThreshold mem6="100" mem8="100" mem12="100"/>
		<iopgpConfig appTraceThreshold="1" totalTraceThreshold="50" thermalLevelThreshold="9" compilerTime="5000"/>
		<ioOpenSlot mem6="2" mem8="2" mem12="2"/>
		
		<!-- io boost slot manager-->
		<ioBoostConfig appTraceThreshold="1" totalTraceThreshold="20" thermalLevelThreshold="9" ioBoostLevelThreshold="200" ioBoostTimeout="400"
		ioBoostCompilerTime="20000"/>
		<ioBoostSlot slot="20"/>
		<ioBoostPkg pkg="com.tencent.mm"/>
		<ioBoostPkg pkg="com.xunmeng.pinduoduo"/>
		<ioBoostPkg pkg="com.ss.android.ugc.aweme"/>
		<ioBoostPkg pkg="com.smile.gifmaker"/>
		<ioBoostPkg pkg="com.kuaishou.nebula"/>
		<ioBoostPkg pkg="com.taobao.taobao"/>
		<ioBoostPkg pkg="com.ss.android.ugc.aweme.lite"/>
		<ioBoostPkg pkg="com.eg.android.AlipayGphone"/>
		<ioBoostPkg pkg="com.tencent.mobileqq"/>
		<ioBoostPkg pkg="com.baidu.searchbox"/>
		<ioBoostPkg pkg="com.whatsapp"/>
		<ioBoostPkg pkg="com.facebook.katana"/>
		<ioBoostPkg pkg="com.coloros.gallery3d"/>
		<ioBoostPkg pkg="jp.naver.line.android"/>
		<ioBoostPkg pkg="com.ss.android.ugc.trill"/>
		<ioBoostPkg pkg="com.facebook.orca"/>
		<ioBoostPkg pkg="com.android.chrome"/>
		<ioBoostPkg pkg="com.google.android.youtube"/>
		<ioBoostPkg pkg="com.instagram.android"/>
		<ioBoostPkg pkg="com.google.android.googlequicksearchbox"/>

		<!-- iopgpSystem --> 
		<iopgpSystemPkg pkg="com.coloros.gallery3d"/>

		<!-- dexPreloadConfig -->
		<dexPreloadConfig switch="true" threshold="100"/>
		
		<!-- usap switch config -->
		<usapSwitch switch="false"/>

		<!-- preopen camera config -->
		<preOpenCamera switch="true"/>

		<!-- breeno -->
		<breenoPreloadConfig processSlots="1" maxPreloadCntInDay="200" />
  </config>

  <config name="io">
		<!-- switch -->
		<switchConfig enable="true"/>

		<!-- limit factor-->
		<limitFactorConfig full="200" light="500"/>

		<!-- black app list-->
		<blackPkg pkg="com.coloros.bootreg"/>
		
		<!-- hotstart -->
		<hotStartSwitch enable="true"/>
		<hotStartConfig filePagePctThd="50" updateInvThd="60000"/>
		<hotStartLimitFactorConfig full="100" light="250"/>

		<!--officeConfig-->
		<officeSwitch enable="true"/>
		<officeScene pkg="com.lemon.lv" activity="com.vega.edit.editpage.activity.EditActivity"/>
		
		<!-- miniprogram config -->
		<miniProgramSwitch enable="true" />
		<miniProgram pkg="com.tencent.mm" recordProc="com.tencent.mm:appbrand0"
			preloadProcList="com.tencent.mm:appbrand0|com.tencent.mm:appbrand1|com.tencent.mm:appbrand2|com.tencent.mm:appbrand3|com.tencent.mm:appbrand4" />

		<!-- minigame config -->
		<miniGameSwitch enable="true" />
		<miniGame pkg="com.nearme.instant.platform" recordProc="com.nearme.instant.platform:game0"
			preloadProcPrefixList="com.nearme.instant.platform:game" preloadClass="com.nearme.instant.quickgame.game.FastLaunchWorker"/>
  </config>
</resources>