buffers: {
    size_kb: 35000
    fill_policy: RING_BUFFER
}
buffers: {
    size_kb: 2048
    fill_policy: DISCARD
}

compression_type:COMPRESSION_TYPE_DEFLATE

data_sources: {
    config {
        name: "android.packages_list"
        target_buffer: 1
    }
}
data_sources: {
    config {
        name: "linux.system_info"
        target_buffer: 1
    }
}
data_sources: {
    config {
        name: "linux.process_stats"
        target_buffer: 1
        process_stats_config {
            scan_all_processes_on_start: true
            record_thread_names: true
            proc_stats_poll_ms: 30000
        }
    }
}
data_sources: {
    config {
        name: "linux.sys_stats"
        sys_stats_config {
            cpufreq_period_ms: 1000
        }
    }
}

trigger_config: {
    trigger_mode: CLONE_SNAPSHOT
    trigger_timeout_ms: 4320000000
    triggers: {
        name: "sys_ostats_pefetto_trigger"
    }
}

