service ostats_tpd /system_ext/bin/ostats_tpd
    user system
    group root system readtracefs media_rw
    disabled

on property:sys.boot_completed=1 && property:persist.sys.ostats_tpd.enable=0
    stop ostats_tpd

on property:sys.boot_completed=1 && property:persist.sys.ostats_tpd.start=0
    stop ostats_tpd

on property:sys.boot_completed=1 && property:persist.sys.ostats_tpd.enable=1
    start ostats_tpd

on property:sys.boot_completed=1 && property:persist.sys.ostats_tpd.start=1
    start ostats_tpd

on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=0
    start ostats_tpd

on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=1
    stop ostats_tpd
