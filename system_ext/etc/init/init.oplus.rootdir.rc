on post-fs-data
    mkdir /data/misc/tmpstor 0766 system system
    chmod 0766 /data/misc/tmpstor
#endif

#ifdef OPLUS_FEATURE_AI
on post-fs-data
    #OuZijian@AI, 2025/2/20, create data path for ai models
    mkdir /data/oplus/os/ai 0770 system system_ai
#endif