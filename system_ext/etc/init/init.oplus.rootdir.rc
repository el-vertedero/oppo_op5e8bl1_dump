    restorecon /data/system/oplus-dex

#zhangqing@ANDROID.DEXOPT, 2025/3/27, update for control light OS cpu set when high tem
on post-fs-data
    mkdir /data/system/oplus-dex/light 0770 system system
    restorecon /data/system/oplus-dex/light
