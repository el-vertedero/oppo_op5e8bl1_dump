service ostats_pullerd /system_ext/bin/ostats_pullerd
    user root
    group root system media_rw
    disabled

on property:sys.boot_completed=1 && property:persist.sys.ostats_pullerd.enable=0
    stop ostats_pullerd

on property:sys.boot_completed=1 && property:persist.sys.ostats_pullerd.start=0
    stop ostats_pullerd

on property:sys.boot_completed=1 && property:persist.sys.ostats_pullerd.enable=1
    start ostats_pullerd

on property:sys.boot_completed=1 && property:persist.sys.ostats_pullerd.start=1
    start ostats_pullerd

on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=0
    start ostats_pullerd

on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=1
    stop ostats_pullerd
