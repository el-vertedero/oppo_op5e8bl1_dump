service oplus_kohash_sys /system/system_ext/bin/oplus_kohashprocess
    class late_start
    user system
    group root system
    disabled
    oneshot

on property:oplus.device.firstboot=* && property:sys.boot_completed=1 && property:vendor.all.modules.ready=1
    mkdir /data/oplus/persist_hash 0770 system system
    start oplus_kohash_sys
