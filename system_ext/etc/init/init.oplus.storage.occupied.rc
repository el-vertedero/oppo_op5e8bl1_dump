on property:sys.oplus.storage.occupied=1
    exec_background u:r:fsck:s0 root root -- /system/bin/occupied.f2fs --mount-check-jump --log-file /data/persist_log/storage/occupied_scan_data.log /dev/block/${dev.mnt.blk.userdata}

on property:sys.oplus.storage.occupied.scanning=1
    exec_background u:r:fsck:s0 root root -- /system/bin/occupied.f2fs --mount-check-jump --log-file /data/persist_log/storage/occupied_scan_data.log /dev/block/${dev.mnt.blk.userdata}

on property:sys.boot_completed=1
    # Add a cpuset for occupied.f2fs
    mkdir /dev/cpuset/storage_occupied
    write /dev/cpuset/storage_occupied/cpus 0-3
    write /dev/cpuset/storage_occupied/mems 0
    chmod 0660 /dev/cpuset/storage_occupied/tasks

