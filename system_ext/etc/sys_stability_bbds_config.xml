<?xml version="1.0" encoding="UTF-8"?>

<filter-conf>
    <version>2026030901</version>
    <filter-name>sys_stability_bbds_config</filter-name>
    <resource type="1" name="PendingIntentRecord" enable="true" threshold="10000" action="none"       logswitch="true"></resource>
    <resource type="2" name="ServiceConnection"   enable="true" threshold="2000"  action="none"       logswitch="true"></resource>
    <resource type="3" name="Receivers"           enable="true" threshold="900"   action="none"       logswitch="true"></resource>
    <resource type="4" name="Alarms"              enable="true" threshold="500"   action="none"       logswitch="true"></resource>
    <resource type="5" name="BinderThread"        enable="true" threshold="500"   action="none"       logswitch="true"></resource>
    <resource type="6" name="BinderParcelSize"    enable="true" threshold="200"   action="none"       logswitch="true"></resource>
    <resource type="7" name="BinderBufferSize"    enable="true" threshold="-1"    action="none"       logswitch="true"></resource>
    <resource type="8" name="OutOfResource"       enable="true" threshold="-1"    action="none"       logswitch="true"></resource>
    <resource type="9" name="Thread"              enable="true" threshold="-1"    action="none"       logswitch="true"></resource>
    <resource type="10" name="Lowmem"             enable="true" threshold="-1"    action="none"       logswitch="true"></resource>
    <resource type="11" name="BinderPendTransact" enable="true" threshold="-1"    action="none"       logswitch="true"></resource>
    <GmsWVRestrictedSwitch>2</GmsWVRestrictedSwitch>
    <GservicesRestrictedSwitch>1</GservicesRestrictedSwitch>
    <GservicesRestrictedList>
        <gservices_restricted_app name="com.tencent.mm" />
    </GservicesRestrictedList>
    <BindTopAppSwitch>1</BindTopAppSwitch>
    <NfwVolumeTimeoutProductList>
        <volume_timeout_product name="PLY110" />
        <volume_timeout_app name="com.ss.android.ugc.aweme" />
        <volume_timeout_app name="com.ss.android.ugc.aweme.lite" />
        <volume_timeout_app name="com.ss.android.ugc.live" />
        <volume_timeout_app name="com.tencent.tmgp.sgame" />
    </NfwVolumeTimeoutProductList>
    <doDumpSwitch>1</doDumpSwitch>
    <NfwVolumeTimeoutValue>10000</NfwVolumeTimeoutValue>
    <BinderStacktraceDumpEnabled>true</BinderStacktraceDumpEnabled>
    <skipAnrReportSwitch>1</skipAnrReportSwitch>
    <InterceptNfwAnrSwitch>true</InterceptNfwAnrSwitch>
</filter-conf>
