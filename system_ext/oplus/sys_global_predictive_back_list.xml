<?xml version='1.0' encoding='UTF-8'?>
<filter-conf>
    <version>20250904</version>
    <filter-name>sys_global_predictive_back_list</filter-name>
    <func_switch value="1" />

    <Application enable="1" packageName="com.android.mms" enable_onbackpressed="1" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.oplus.camera" enable_onbackpressed="1">
    </Application>
    <Application enable="1" packageName="com.heytap.speechassist" enable_onbackpressed="1">
    </Application>
    <Application enable="1" packageName="com.android.contacts" enable_onbackpressed="1">
    </Application>
    <!-- 预测性动画backType: 0不支持,1支持, 第一位TYPE_RETURN_TO_HOME, 第二位TYPE_CROSS_TASK, 第三位TYPE_CROSS_ACTIVITY-->
    <Application enable="1" packageName="com.coloros.assistantscreen" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.heytap.market" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.coloros.backuprestore" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.heytap.browser" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.oneplus.store" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.oneplus.mall" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.heytap.reader" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.nearme.gamecenter" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.oplus.consumerIRApp" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.oplus.tips" backType="1:0:0">
    </Application>
    <Application enable="1" packageName="com.coloros.note" backType="1:0:0">
    </Application>

    <Application enable="0" packageName="com.facebook.orca" whitelist_enforce="0">
    </Application>

    <Application enable="0" packageName="com.zing.zalo" whitelist_enforce="0">
    </Application>
</filter-conf>
