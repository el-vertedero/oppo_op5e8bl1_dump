		mtksmmu3 = "/soc/iommu@48600000";
		exdma0 = "/soc/disp-ovl0-exdma0@32930000";
		exdma2 = "/soc/disp-ovl0-exdma2@32950000";
		disp-dvo1 = "/soc/disp-dvo1@3e950000";
		exdma3 = "/soc/disp-ovl0-exdma3@32960000";
		exdma4 = "/soc/disp-ovl0-exdma4@32970000";
		exdma5 = "/soc/disp-ovl0-exdma5@32980000";
		exdma6 = "/soc/disp-ovl0-exdma6@32990000";
		exdma7 = "/soc/disp-ovl0-exdma7@329a0000";
		exdma12 = "/soc/disp-ovl1-exdma2@32c50000";
		exdma13 = "/soc/disp-ovl1-exdma3@32c60000";
		exdma14 = "/soc/disp-ovl1-exdma4@32c70000";
		exdma15 = "/soc/disp-ovl1-exdma5@32c80000";
		exdma16 = "/soc/disp-ovl1-exdma6@32c90000";
		exdma17 = "/soc/disp-ovl1-exdma7@32ca0000";
		exdma22 = "/soc/disp-ovl2-exdma2@3e050000";
		exdma23 = "/soc/disp-ovl2-exdma3@3e060000";
		exdma24 = "/soc/disp-ovl2-exdma4@3e070000";
		exdma25 = "/soc/disp-ovl2-exdma5@3e080000";
		blender0 = "/soc/disp-ovl0-blender0@329b0000";
		blender1 = "/soc/disp-ovl0-blender1@329c0000";
		blender2 = "/soc/disp-ovl0-blender2@329d0000";
		blender3 = "/soc/disp-ovl0-blender3@329e0000";
		blender4 = "/soc/disp-ovl0-blender4@329f0000";
		blender5 = "/soc/disp-ovl0-blender5@32a00000";
		blender6 = "/soc/disp-ovl0-blender6@32a10000";
		blender7 = "/soc/disp-ovl0-blender7@32a20000";
		blender10 = "/soc/disp-ovl1-blender0@32cb0000";
		blender11 = "/soc/disp-ovl1-blender1@32cc0000";
		blender12 = "/soc/disp-ovl1-blender2@32cd0000";
		blender13 = "/soc/disp-ovl1-blender3@32ce0000";
		blender14 = "/soc/disp-ovl1-blender4@32cf0000";
		blender15 = "/soc/disp-ovl1-blender5@32d00000";
		blender16 = "/soc/disp-ovl1-blender6@32d10000";
		blender17 = "/soc/disp-ovl1-blender7@32d20000";
		blender20 = "/soc/disp-ovl2-blender0@3e0b0000";
		blender21 = "/soc/disp-ovl2-blender1@3e0c0000";
		blender22 = "/soc/disp-ovl2-blender2@3e0d0000";
		blender23 = "/soc/disp-ovl2-blender3@3e0e0000";
		outproc0 = "/soc/disp-ovl0-outproc0@32a30000";
		outproc1 = "/soc/disp-ovl0-outproc1@32a40000";
		outproc2 = "/soc/disp-ovl0-outproc2@32a50000";
		outproc3 = "/soc/disp-ovl0-outproc3@32a60000";
		outproc6 = "/soc/disp-ovl1-outproc0@32d30000";
		outproc7 = "/soc/disp-ovl1-outproc1@32d40000";
		outproc8 = "/soc/disp-ovl1-outproc2@32d50000";
		outproc9 = "/soc/disp-ovl1-outproc3@32d60000";
		outproc12 = "/soc/disp-ovl2-outproc0@3e130000";
		outproc13 = "/soc/disp-ovl2-outproc1@3e140000";
		outproc14 = "/soc/disp-ovl2-outproc2@3e150000";
		ovl0-dlo-async12 = "/soc/ovl0-dlo-async12@32900000";
		ovl2-dlo-async12 = "/soc/ovl2-dlo-async12@3e000000";
		dli-async0 = "/soc/dli-async0@3e300000";
		dlo-async0 = "/soc/dlo-async0@3e300000";
		dli-async20 = "/soc/dli-async20@3e700000";
		dlo-async16 = "/soc/dlo-async16@3e300000";
		dli-async29 = "/soc/dli-async29@3e700000";
		dlo-async1 = "/soc/dlo-async1@3e300000";
		dli-async21 = "/soc/dli-async21@3e700000";
		dlo-async17 = "/soc/dlo-async17@3e300000";
		dli-async30 = "/soc/dli-async30@3e700000";
		dli-async-b2 = "/soc/dli-async2-b@3e500000";
		dlo-async-b0 = "/soc/dlo-async0-b@3e500000";
		dli-async-b20 = "/soc/dli-async20-b@3e900000";
		relay5 = "/soc/disp-relay5@3e300000";
		tdshp0 = "/soc/disp-tdshp0@3e440000";
		tdshp4 = "/soc/disp-tdshp1@3e640000";
		color0 = "/soc/disp-color0@3e380000";
		color3 = "/soc/disp-color1@3e580000";
		ccorr0 = "/soc/disp-ccorr0@3e360000";
		ccorr1 = "/soc/disp-ccorr1@3e370000";
		ccorr8 = "/soc/disp-ccorr2@3e560000";
		ccorr9 = "/soc/disp-ccorr3@3e570000";
		c3d0 = "/soc/disp-c3d0@3e340000";
		c3d1 = "/soc/disp-c3d1@3e350000";
		c3d4 = "/soc/disp-c3d2@3e540000";
		c3d5 = "/soc/disp-c3d3@3e550000";
		aal0 = "/soc/disp-aal0@3e330000";
		aal2 = "/soc/disp-aal1@3e530000";
		maal0 = "/soc/disp-mdp-aal0@3e3c0000";
		maal2 = "/soc/disp-mdp-aal1@3e5c0000";
		gamma0 = "/soc/disp-gamma0@3e3b0000";
		gamma4 = "/soc/disp-gamma1@3e5b0000";
		dither0 = "/soc/disp-dither0@3e390000";
		dither1 = "/soc/disp-dither1@3e3a0000";
		dither4 = "/soc/disp-dither2@3e590000";
		dither5 = "/soc/disp-dither3@3e5a0000";
		chist0 = "/soc/disp-chist0@3e790000";
		chist1 = "/soc/disp-chist1@3e7a0000";
		spr0 = "/soc/disp-spr0@3e3f0000";
		spr2 = "/soc/disp-spr2@3e600000";
		postalign0 = "/soc/disp-postalign0@3e7c0000";
		postalign2 = "/soc/disp-postalign2@3e9c0000";
		oddmr0 = "/soc/disp-oddmr0@3e410000";
		oddmr2 = "/soc/disp-oddmr2@3e610000";
		dbi-count0 = "/soc/disp-dbi-count0@3e780000";
		mdp-rsz0 = "/soc/disp-rsz0@3e430000";
		mdp-rsz6 = "/soc/disp-rsz1@3e630000";
		postmask0 = "/soc/disp-postmask0@3e3d0000";
		postmask2 = "/soc/disp-postmask1@3e5d0000";
		mdp-rsz2 = "/soc/ovl-rsz0@32a70000";
		bwm0 = "/soc/disp-bwm0@3eee0000";
		dsc0 = "/soc/disp1-dsc-wrap0@3e7f0000";
		dsi0 = "/soc/dsi@3e730000";
		mutex0 = "/soc/disp1-mutex0@3e320000";
		wdma1 = "/soc/disp1-wdma1@3e770000";
		ovl0-dli-async0 = "/soc/ovl-dli-async0@32900000";
		mml-mutex0 = "/soc/mml1-mutex0@32320000";
		mml-mutex1 = "/soc/mml2-mutex0@32620000";
		mml-wrot0 = "/soc/mml2-wrot0@326c0000";
		mml-wrot1 = "/soc/mml2-wrot1@32750000";
	};

	aov {
		compatible = "mediatek,aov";
		status = "okay";
		op-mode = <0x01>;
		mediatek,larbs-uisp = <0x02>;
		scp-dvfs-supply = <0x03>;
		apu-supply = <0x04>;
		sensor-i2c = <0x05 0x06 0x07>;
		ulposc-support;
		base = <0x1c204000>;
		ver = "v2";
		phandle = <0x351>;
	};

	cache-parity {
		compatible = "mediatek,mt6985-cache-parity";
		ecc-irq-support = <0x01>;
		arm-dsu-ecc-hwirq = <0x3e>;
		interrupts = <0x00 0x00 0x04 0x00 0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x1e 0x04 0x00>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup \t\t\t    8250.nr_uarts=4 \t\t\t    androidboot.hardware=mt6993 \t\t\t    android_arch_task_struct_size=512 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    firmware_class.path=/vendor/firmware \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    log_buf_len=2m \t\t\t    transparent_hugepage=never \t\t\t    arm64.nomops \t\t\t    hyp_trace_printk hyp_event=__hyp_printk \t\t\t    kvm-arm.hyp_lm_size_mb=2000                             erofs.reserved_pages=256 \t\t\t    kvm-arm.protected_prefault=9 \t\t\t    kvm-arm.protected_modules=pkvm_mgmt,pkvm_tmem,pkvm_smmu,pkvm_mkp,pkvm_isp,pkvm_cmdq";
		mkp_panic = "on";
		phandle = <0x23>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x08 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a 0x0b 0x0c 0x0d>;
			capacity-dmips-mhz = <0x319>;
			phandle = <0x14>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x08 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a 0x0b 0x0c 0x0d>;
			capacity-dmips-mhz = <0x319>;
			phandle = <0x15>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x08 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a 0x0b 0x0c 0x0d>;
			capacity-dmips-mhz = <0x319>;
			phandle = <0x16>;
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x08 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a 0x0b 0x0c 0x0d>;
			capacity-dmips-mhz = <0x319>;
			phandle = <0x17>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x08 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0e 0x0f 0x10 0x0c 0x0d>;
			capacity-dmips-mhz = <0x3b8>;
			phandle = <0x18>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x08 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0e 0x0f 0x10 0x0c 0x0d>;
			capacity-dmips-mhz = <0x3b8>;
			phandle = <0x19>;
		};

		cpu@102 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x08 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0e 0x0f 0x10 0x0c 0x0d>;
			capacity-dmips-mhz = <0x3b8>;
			phandle = <0x1a>;
		};

		cpu@200 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x08 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x11 0x12 0x13 0x0c 0x0d>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x1b>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x15>;
				};

				core2 {
					cpu = <0x16>;
				};

				core3 {
					cpu = <0x17>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x18>;
				};

				core1 {
					cpu = <0x19>;
				};

				core2 {
					cpu = <0x1a>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x1b>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x61>;
				exit-latency-us = <0xb2>;
				min-residency-us = <0x252e>;
				phandle = <0x09>;
			};

			cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x57>;
				exit-latency-us = <0xba>;
				min-residency-us = <0x1cde>;
				phandle = <0x0e>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x57>;
				exit-latency-us = <0xbd>;
				min-residency-us = <0x10c3>;
				phandle = <0x11>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xfa>;
				exit-latency-us = <0x149>;
				min-residency-us = <0x252e>;
				phandle = <0x0a>;
			};

			clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xfa>;
				exit-latency-us = <0x169>;
				min-residency-us = <0x1cde>;
				phandle = <0x0f>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xfa>;
				exit-latency-us = <0x161>;
				min-residency-us = <0x1384>;
				phandle = <0x12>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x5c0>;
				exit-latency-us = <0x77c>;
				min-residency-us = <0x252e>;
				phandle = <0x0b>;
			};

			mcusysoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x5b0>;
				exit-latency-us = <0x78a>;
				min-residency-us = <0x1cde>;
				phandle = <0x10>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x5a0>;
				exit-latency-us = <0x71d>;
				min-residency-us = <0x1384>;
				phandle = <0x13>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x3ac>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x8980>;
				phandle = <0x0c>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0d>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	interrupt-controller@6800000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0x6800000 0x00 0x40000 0x00 0x6880000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04 0x00>;
		phandle = <0x01>;

		ppi-partitions {

			interrupt-partition-0 {
				affinity = <0x14 0x15 0x16 0x17>;
				phandle = <0x43>;
			};

			interrupt-partition-1 {
				affinity = <0x18 0x19 0x1a>;
				phandle = <0x42>;
			};

			interrupt-partition-2 {
				affinity = <0x1b>;
				phandle = <0x41>;
			};
		};
	};

	gic-ram-parity {
		compatible = "mediatek,gic-ram-parity";
		interrupts = <0x00 0x9f 0x01 0x00 0x00 0xa0 0x01 0x00>;
		interrupt-names = "fault_handling_interrupt\0error_recovery_interrupt";
		phandle = <0x352>;
	};

	teeperf {
		compatible = "mediatek,teeperf";
		cpu-type = <0x01>;
		cpu-map = <0x01>;
		svp-cpu-index = <0x0e>;
	};

	mobicore {
		compatible = "trustonic,mobicore";
		interrupts = <0x00 0x96 0x01 0x00>;
		phandle = <0x353>;
	};

	utos {
		compatible = "microtrust,utos";
		interrupts = <0x00 0x97 0x01 0x00>;
		phandle = <0x354>;
	};

	spmi@1c01a000 {
		compatible = "mediatek,mt6993-spmi";
		reg = <0x00 0x1c01a000 0x00 0x111c 0x00 0x1c01c000 0x00 0x100 0x00 0x1c018000 0x00 0x111c 0x00 0x1c01c800 0x00 0x100>;
		reg-names = "pmif\0spmimst\0pmif-p\0spmimst-p";
		interrupts-extended = <0x1c 0x110 0x04 0x1c 0x111 0x04 0x01 0x00 0x1a7 0x04 0x00 0x01 0x00 0x211 0x04 0x00 0x01 0x00 0x1a8 0x04 0x00 0x01 0x00 0x212 0x04 0x00>;
		interrupt-names = "rcs_irq\0rcs_irq_p\0pmif_irq\0spmi_nack_irq\0pmif_p_irq\0spmi_p_nack_irq";
		interrupt-controller;
		#interrupt-cells = <0x01>;
		irq-event-en = <0xc0000000 0x01 0x00 0x00 0x00>;
		irq-event-en-p = <0xc0000000 0x01 0x00 0x00 0x00>;
		spmi-dev-mask = <0x55a8>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		hwinf-err-irq-idx = <0x21 0x30>;
		swinf-err-irq-idx = <0x71 0x76>;
		rcs-mask-list = <0x04 0x04>;
		phandle = <0x296>;

		pmic@f {
			compatible = "mediatek,mt6688";
			reg = <0x0f 0x00>;
			vs2-supply = <0x1d>;
			phandle = <0x355>;

			regulators {

				vbst {
					regulator-name = "mt6688-vbst";
					regulator-min-microvolt = <0x2c4020>;
					regulator-max-microvolt = "\0=\t";
					regulator-always-on;
				};

				vck12 {
					regulator-name = "mt6688-vck12";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
					regulator-allowed-modes = <0x00 0x01>;
					regulator-always-on;
				};

				vck18 {
					regulator-name = "mt6688-vck18";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1e8480>;
					regulator-allowed-modes = <0x00 0x01>;
					regulator-always-on;
				};

				aux18 {
					regulator-name = "mt6688-aux18";
