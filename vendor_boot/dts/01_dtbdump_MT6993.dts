/dts-v1/;

/ {
	model = "MT6993";
	compatible = "mediatek,MT6993";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@12950000";
		i2c1 = "/soc/i2c@13950000";
		i2c2 = "/soc/i2c@123d0000";
		i2c3 = "/soc/i2c@12970000";
		i2c4 = "/soc/i2c@12450000";
		i2c5 = "/soc/i2c@12350000";
		i2c6 = "/soc/i2c@12990000";
		i2c7 = "/soc/i2c@124d0000";
		i2c8 = "/soc/i2c@12550000";
		i2c9 = "/soc/i2c@139d0000";
		i2c10 = "/soc/i2c@129b0000";
