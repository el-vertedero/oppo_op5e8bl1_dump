	pkvm {
		status = "disable";
		mtkcam-security-cam-normal-preview-support = "disable";
		phandle = <0x65d>;
	};

	trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x00>;
		tee-name = "trusty";
		phandle = <0x65e>;

		trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0x245>;
		};

		trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
			phandle = <0x34e>;
		};

		tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0x245>;
			irq-supply = <0x34e>;
			phandle = <0x34f>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x34f>;
			phandle = <0x246>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};

		trusty-sapu {
			compatible = "mediatek,trusty-sapu";
			power-version = <0x02>;
			datamem-type = <0x02>;
			datamem-size = <0x00 0x00 0x00 0x00>;
			smmu-device = <0x350>;
			status = "okay";
		};
	};

	nebula-log {
		compatible = "android,nebula-log-v1";
		status = "disabled";
		phandle = <0x65f>;
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x660>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor {
		compatible = "mediatek,geniezone-hyp\0mediatek,geniezone";
		status = "okay";
		phandle = <0x661>;
	};

