	mtk-lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		lpm-kernel-suspend = <0x00>;
		suspend-method = "enable";
		common-sodi = <0x01>;
		logger-enable-states = "mcusysoff_l\0mcusysoff_m\0mcusysoff_b\0system_vcore";
		irq-remain = <0x13a 0x13b 0x13c 0x13d 0x13e 0x13f 0x140 0x141 0x142 0x143 0x144 0x145 0x146 0x147 0x148 0x149>;
		resource-ctrl = <0x14a 0x14b 0x14c 0x14d 0x14e 0x14f 0x150 0x151 0x152 0x153 0x154>;
		constraints = <0x155 0x156>;
		lpm-gov-enable = <0x01>;
		cpu-gov-info = <0x157 0x158 0x159>;
		cg-shift = <0x00>;
		pll-shift = <0x00>;
		mcusys-cnt-chk = <0x00>;
		hwreq = "hw_cg\0peri_req";
		phandle = <0x3f8>;

		cpupm-sysram@11b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0x3f9>;
		};

		mcusys-ctrl@5260000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0x5260000 0x00 0x1000>;
			phandle = <0x3fa>;
		};

		lpm-sysram@11b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0x3fb>;
		};

		ocla-sram@1c03e000 {
			compatible = "mediatek,ocla-sram";
			reg = <0x00 0x1c03e000 0x00 0x2000>;
			phandle = <0x3fc>;
		};

		irq-remain-list {

			edge-keypad {
				target = <0x15a>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0x13a>;
			};

			level-spi0 {
				target = <0x15b>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x13b>;
			};

			level-spi1 {
