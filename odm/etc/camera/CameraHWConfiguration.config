[CzFeaturePipeline]
    # Streaming/Capture[ID] : Node1; Node2; Node3
    #    ID : see CzFeatureScenarioType
    #    NodeX : see CzFeatureNodeType

    ## 1. streaming
    Streaming[1] = SROOT; SAT; NAV; EIS; VRP; ASYNC; META; SCOMMON;
    Streaming[2] = SROOT; SAT; VRP; META; SCOMMON;
    Streaming[3] = SROOT; SAT; NAV; VAINR; TRAW; EIS; VRP; SWDC; SOD; VWM; ASYNC; META; SCOMMON;
    Streaming[4] = SROOT; SAT; NAV; MCNR; EIS; WARP; ASYNC; META; SCOMMON;
    Streaming[5] = SROOT; SAT; NAV; VAINR; TRAW; MCNR; EIS; WARP; SWDC; SOD; VWM; ASYNC; META; SCOMMON;

    ## 2. capture
    Capture[51] = CROOT; MWCS; RAW; BSS; PACK; CCOMMON;
    Capture[52] = CROOT; RAW; CWDC; BSS; JPEG; CCOMMON;
    Capture[53] = CROOT; REPROCESS;
    Capture[54] = CROOT; MFNR; RAW; CWDC; JPEG; CCOMMON;

    # default inline
    NonInlineModeList = 0x80a3; 0x802c;

