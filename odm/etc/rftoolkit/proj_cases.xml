            </Band>
        </RAT>
        <RAT name="LTE">
            <Band type="Any">
                <Channel type="Low">
                    <SubBand>0</SubBand>
                </Channel>
                <Channel type="High">
                    <SubBand>0</SubBand>
                </Channel>
            </Band>
        </RAT>
        <RAT name="NR5G">
            <Band type="Any">
                <Channel type="Low">
                    <SubBand>0</SubBand>
                </Channel>
                <Channel type="High">
                    <SubBand>0</SubBand>
