<?xml version="1.0" encoding="utf-8"?>
<RFTOOLKIT>
    <TestCase mode="NPT" auto_qurry_antenna_ext="true">
        <RAT name="GSM" pwrcheck="false">
            <Band number="850,900">
                <Channel type="Low">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT0&&ANT1-->
                </Channel>
                <Channel type="Mid">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT0&&ANT1-->
                </Channel>
                <Channel type="High">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT0&&ANT1-->
                </Channel>
            </Band>
            <Band number="1800,1900">
                <Channel type="Low">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT6&&ANT5-->
                </Channel>
                <Channel type="Mid">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT6&&ANT5-->
                </Channel>
                <Channel type="High">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>  <!--ANT6&&ANT5-->
                </Channel>
            </Band>
        </RAT>
        <RAT name="LTE">
           <Band type="Any">
                <Channel type="Mid">
                     <SubBand>0</SubBand>
                </Channel>
            </Band>
        </RAT>
        <RAT name="NR5G">
           <Band type="Any">
                <Channel type="Mid">
                     <SubBand>0</SubBand>
                </Channel>
            </Band>
        </RAT>
    </TestCase>
